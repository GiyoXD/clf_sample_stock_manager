{
  "name": "sample-manager-backend",
  "version": "1.0.7",
  "bin": "server.js",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build-exe": "caxa --input . --output sample-manager-backend.exe -- \"{{caxa}}/node.exe\" \"{{caxa}}/server.js\" {{args}}"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.11"
  },
  "devDependencies": {
    "caxa": "^3.0.1",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": "node_modules/better-sqlite3/lib/**/*.js",
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "."
  }
}